			"type": "string",
			"defaultValue": "free-sql-db-7410058"
		},
		"LS_AzureSQL_Finance_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"LS_CheckClaimRisk_properties_typeProperties_functionAppUrl": {
			"type": "string",
			"defaultValue": "https://fa-insurance-dev-bmchfgguc8dbebgu.westus3-01.azurewebsites.net"
		},
		"LS_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://insurance-kv-dev.vault.azure.net/"
		},
