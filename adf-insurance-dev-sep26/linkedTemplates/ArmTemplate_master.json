		"LS_LocalPostgres_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "insurance_oltp"
		},
		"LS_LocalPostgres_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "postgres"
		},
		"conn_blob_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://insurancesep26.dfs.core.windows.net/"
		},
