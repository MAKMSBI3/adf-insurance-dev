						"value": "[parameters('AzureDataLakeStorageCSV_properties_typeProperties_url')]"
					},
					"AzureDataLakeStorageParquet_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorageParquet_properties_typeProperties_url')]"
					},
					"LS_CheckClaimRisk_properties_typeProperties_functionAppUrl": {
						"value": "[parameters('LS_CheckClaimRisk_properties_typeProperties_functionAppUrl')]"
					},
					"LS_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_properties_typeProperties_baseUrl')]"
					},
					"conn_blob_properties_typeProperties_url": {
						"value": "[parameters('conn_blob_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_Finance_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_Finance_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_Finance_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_Finance_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_Finance_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_Finance_properties_typeProperties_userName')]"
					},
					"LS_LocalPostgres_properties_typeProperties_server": {
						"value": "[parameters('LS_LocalPostgres_properties_typeProperties_server')]"
					},
					"LS_LocalPostgres_properties_typeProperties_database": {
						"value": "[parameters('LS_LocalPostgres_properties_typeProperties_database')]"
					},
					"LS_LocalPostgres_properties_typeProperties_username": {
						"value": "[parameters('LS_LocalPostgres_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-insurance-dev-sep26_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"TR_Nightly_Settlement_properties_PL_Settlement_Intake_parameters_runDate": {
						"value": "[parameters('TR_Nightly_Settlement_properties_PL_Settlement_Intake_parameters_runDate')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-insurance-dev-sep26_ArmTemplate_0')]"
			]
		}
