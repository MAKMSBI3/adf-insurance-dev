										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "manifestFound",
										"value": {
											"value": "@activity('GM_CheckManifest').output.exists",
											"type": "Expression"
										}
									}
								},
								{
									"name": "WAIT_30Sec",
									"type": "Wait",
									"dependsOn": [
										{
											"activity": "SV_ManifestFound",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": {
											"value": "@if(variables('manifestFound'), 1, 30)",
											"type": "Expression"
										}
									}
								}
							],
							"timeout": "0.00:05:00"
						}
					},
