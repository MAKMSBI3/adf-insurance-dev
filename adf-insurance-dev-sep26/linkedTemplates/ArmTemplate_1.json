{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-insurance-dev-sep26"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_Settlement_Intake')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "UNTIL_WaitForManifest",
						"type": "Until",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@variables('manifestFound')",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "GM_CheckManifest",
									"type": "GetMetadata",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataset": {
											"referenceName": "DS_ADLS_File_Binary",
											"type": "DatasetReference",
											"parameters": {
												"folderPath": {
													"value": "@concat('landing/', formatDateTime(pipeline().parameters.runDate, 'yyyy/MM/dd'))",
													"type": "Expression"
												},
												"fileName": {
													"value": "@concat('_MANIFEST_', formatDateTime(pipeline().parameters.runDate, 'yyyyMMdd'), '.ctl')",
													"type": "Expression"
												}
											}
										},
										"fieldList": [
											"exists"
										],
										"storeSettings": {
											"type": "AzureBlobFSReadSettings",
											"recursive": true,
											"enablePartitionDiscovery": false
										},
										"formatSettings": {
											"type": "BinaryReadSettings"
										}
									}
								},
								{
									"name": "SV_ManifestFound",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "GM_CheckManifest",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "manifestFound",
										"value": {
											"value": "@activity('GM_CheckManifest').output.exists",
											"type": "Expression"
										}
									}
								},
								{
									"name": "WAIT_30Sec",
									"type": "Wait",
									"dependsOn": [
										{
											"activity": "SV_ManifestFound",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": {
											"value": "@if(variables('manifestFound'), 1, 30)",
											"type": "Expression"
										}
									}
								}
							],
							"timeout": "0.00:05:00"
						}
					},
					{
						"name": "FAIL_NoPartnerFiles",
						"type": "Fail",
						"dependsOn": [
							{
								"activity": "UNTIL_WaitForManifest",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"message": {
								"value": "@concat('Partner files not received for ', pipeline().parameters.runDate)",
								"type": "Expression"
							},
							"errorCode": "NO_MANIFEST"
						}
					},
					{
						"name": "GM_ListFiles",
						"type": "GetMetadata",
						"dependsOn": [
							{
								"activity": "UNTIL_WaitForManifest",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "DS_ADLS_Folder",
								"type": "DatasetReference",
								"parameters": {
									"folderPath": {
										"value": "@concat('landing/', formatDateTime(pipeline().parameters.runDate, 'yyyy/MM/dd'))",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "BinaryReadSettings"
							}
						}
					},
					{
						"name": "FILTER_CsvFiles",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "GM_ListFiles",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('GM_ListFiles').output.childItems",
								"type": "Expression"
							},
							"condition": {
								"value": "@endswith(item().name, '.csv')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "FOREACH_File",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "FILTER_CsvFiles",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('FILTER_CsvFiles').output.Value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "EXEC_ProcessFile",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_Settlement_Intake_File",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"fileName": {
												"value": "@item().name",
												"type": "Expression"
											},
											"folderPath": {
												"value": "@concat('landing/', formatDateTime(pipeline().parameters.runDate, 'yyyy/MM/dd'))",
												"type": "Expression"
											}
										}
									}
								},
								{
									"name": "AV_ProcessedFile",
									"type": "AppendVariable",
									"dependsOn": [
										{
											"activity": "EXEC_ProcessFile",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"variableName": "processedFiles",
										"value": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "SV_RunSummary",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "FOREACH_File",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "runSummary",
							"value": {
								"value": "@concat('Files processed: ', join(variables('processedFiles'), ', '))",
								"type": "Expression"
							}
						}
					},
					{
						"name": "COPY_ClaimsRef",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "SV_RunSummary",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "PostgreSqlV2Source",
								"query": "SELECT claim_id, claim_amount, claim_status, claim_type FROM claims",
								"queryTimeout": "02:00:00"
							},
							"sink": {
								"type": "AzureSqlSink",
								"preCopyScript": "TRUNCATE TABLE fin.claims_ref",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "OnPrem_Source_PostgreSql",
								"type": "DatasetReference",
								"parameters": {
									"tableName": "claims"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_AzureSQL_Table",
								"type": "DatasetReference",
								"parameters": {
									"schemaName": "fin",
									"tableName": "claims_ref"
								}
							}
						]
					},
					{
						"name": "SP_Reconcile",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "COPY_ClaimsRef",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[fin].[usp_reconcile_settlements]",
							"storedProcedureParameters": {
								"file_list": {
									"value": {
										"value": "@join(variables('processedFiles'), ',')",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL_Finance",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"runDate": {
						"type": "string",
						"defaultValue": "2026-10-11"
					}
				},
				"variables": {
					"manifestFound": {
						"type": "Boolean",
						"defaultValue": false
					},
					"processedFiles": {
						"type": "Array"
					},
					"runSummary": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-18T04:36:31Z"
			},
			"dependsOn": []
		}
	]
}